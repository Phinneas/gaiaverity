---
import Container from "@/components/container.astro";
import Pagetitle from "@/components/pagetitle.astro";
import Postlist from "@/components/postlist.astro";
import Layout from "@/layouts/Layout.astro";
import { getBlogPosts } from "@/lib/sonicjs";

const latestPosts = await getBlogPosts();
---

<Layout title="Blog" desc="All articles from GaiaVerity — sustainable lawn care, native plants, mushroom identification, and more.">
  <Container>
    <Pagetitle>
      <Fragment slot="title">The Blog</Fragment>
      <Fragment slot="desc">
        Practical guides for sustainable lawns, gardens, and outdoor spaces.
      </Fragment>
    </Pagetitle>
    <main>
      <div class="grid gap-10 mt-10 lg:gap-10 md:grid-cols-2 xl:grid-cols-3">
        {latestPosts.map((post) => <Postlist post={post} aspect="square" />)}
      </div>
    </main>
  </Container>
</Layout>
