---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Pagetitle from "@/components/pagetitle.astro";
import Link from "@/components/ui/link.astro";
---

<Layout title="About">
  <Container>
    <Pagetitle>
      <Fragment slot="title">Grow something real.</Fragment>
      <Fragment slot="desc">
        GaiaVerity is a gardening and lawn care resource for people who want to
        work with their land — not against it.
      </Fragment>
    </Pagetitle>

    <div class="mx-auto max-w-4xl mt-12">
      <div class="prose prose-lg dark:prose-invert max-w-none text-gray-600 dark:text-gray-400">
        <p>
          We believe the backyard is one of the most underused ecosystems most
          people will ever own. Whether it's a mossy lawn in the Pacific
          Northwest, a sun-scorched patch of ground crying out for
          drought-resistant cover, or a fence line begging to become a vertical
          garden — every outdoor space holds more possibility than it shows at
          first glance.
        </p>
        <p>
          GaiaVerity was built to make that possibility accessible. We research
          what actually works — from the fungi that quietly enrich your soil to
          the ground covers that crowd out weeds without chemicals — and we
          write about it in plain language for real gardeners, not just Master
          Gardeners with a greenhouse.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-10 mt-16">
        <div>
          <h3 class="font-bold text-xl mb-3 text-gaia-ink">
            Sustainable practices
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            Methods that build soil health and reduce inputs over time — not
            quick fixes that deplete.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-xl mb-3 text-gaia-ink">
            Backyard-scale advice
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            Written for home gardeners with real constraints — small spaces,
            limited time, tight budgets.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-xl mb-3 text-gaia-ink">
            Seasonal, regional content
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            Timing matters. We cover the Pacific Northwest and beyond with
            content tuned to your climate.
          </p>
        </div>
      </div>

      <div class="prose prose-lg dark:prose-invert max-w-none mt-16 text-gray-600 dark:text-gray-400">
        <p>
          Our content spans lawn care, mushroom identification, pest control,
          drought-tolerant planting, vertical and small-space gardening, and
          tree and shrub care — all grounded in the idea that a healthy garden
          is one that takes less from the environment, not more.
        </p>
      </div>

      <div class="mt-12 text-center">
        <Link href="/contact" style="primary">Get in touch</Link>
      </div>
    </div>
  </Container>
</Layout>
