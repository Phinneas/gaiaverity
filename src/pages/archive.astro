---
export const prerender = true;
import Container from "@/components/container.astro";
import Pagetitle from "@/components/pagetitle.astro";
import Postlist from "@/components/postlist.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPostsRaw = await getCollection("blog", ({ data }) => data.draft !== true);
const latestPosts = allPostsRaw.sort((a, b) => new Date(b.data.publishDate || 0).valueOf() - new Date(a.data.publishDate || 0).valueOf());
---

<Layout title="Archive">
  <Container>
    <Pagetitle>
      <Fragment slot="title">Archive</Fragment>
      <Fragment slot="desc">See all posts we have ever written.</Fragment>
    </Pagetitle>
    <main>
      <div class="grid gap-10 mt-10 lg:gap-10 md:grid-cols-2 xl:grid-cols-3">
        {latestPosts.map((post) => <Postlist post={post} aspect="square" />)}
      </div>
    </main>
  </Container>
</Layout>
