---
import Layout from "@/layouts/Layout.astro";
import "@/styles/planters.css";
import PlanterCard from "../../components/PlanterCard.astro";
import Icon from "../../components/Icon.astro";
import { planters } from "../../data/planters";

const filters = [
  { tag: "all", label: "All" },
  { tag: "beginner", label: "Beginner" },
  { tag: "herbs", label: "Herbs" },
  { tag: "design", label: "Design-led" },
  { tag: "hydroponic", label: "Hydroponic" },
  { tag: "vertical", label: "Vertical" },
];
---
<Layout title="AI Planter Catalog — GaiaVerity" desc="Every smart planter we trust, vetted and ranked by the GaiaVerity team.">
<div class="gv-shop">
  <section class="section section--tight">
    <div class="gv-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/planters">Shop</a><span class="sep">/</span><span>Catalog</span>
      </nav>

      <div class="collection-head">
        <div style="max-width:680px">
          <span class="eyebrow">AI Planter Catalog</span>
          <h1 class="h1" style="margin-block:10px 14px">Every smart planter we trust</h1>
          <p class="lead">Smart planters that water, feed and monitor your plants — vetted and ranked by the GaiaVerity team.</p>
        </div>
        <div class="badge-stamp"><Icon name="shield" /> {planters.length} vetted picks</div>
      </div>

      <div class="collection-toolbar">
        <div class="tag-pills" id="tagPills">
          {filters.map((f, i) => (
            <button class:list={["tag-pill", i === 0 && "active"]} data-tag={f.tag}>{f.label}</button>
          ))}
        </div>
        <div class="sort-form">
          <label for="sortBy">Sort</label>
          <select id="sortBy">
            <option>Featured</option>
            <option>Price: low to high</option>
            <option>Price: high to low</option>
            <option>Top rated</option>
            <option>Highest commission</option>
          </select>
        </div>
      </div>

      <div class="product-grid" id="catalogGrid">
        {planters.map((p, i) => <PlanterCard product={p} feature={i === 0} />)}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var pills = document.getElementById("tagPills");
      var grid = document.getElementById("catalogGrid");
      if (!pills || !grid) return;
      pills.addEventListener("click", function (e) {
        var btn = e.target.closest(".tag-pill");
        if (!btn) return;
        pills.querySelectorAll(".tag-pill").forEach(function (b) { b.classList.remove("active"); });
        btn.classList.add("active");
        var tag = btn.getAttribute("data-tag");
        grid.querySelectorAll(".pcard").forEach(function (card) {
          var tags = (card.getAttribute("data-tags") || "").split(" ");
          card.style.display = tag === "all" || tags.indexOf(tag) !== -1 ? "" : "none";
        });
      });
    })();
  </script>
<script is:inline>
(function(){var s=document.querySelector(".gv-shop");if(!s)return;s.classList.add("ready");var els=s.querySelectorAll(".reveal");if("IntersectionObserver" in window){var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add("in");io.unobserve(x.target)}})},{threshold:.12,rootMargin:"0px 0px -40px 0px"});els.forEach(function(el){io.observe(el)})}else{els.forEach(function(el){el.classList.add("in")}})();
</script>
</div>
</Layout>
