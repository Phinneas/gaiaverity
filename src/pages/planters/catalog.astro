---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import PlanterCard from "../../components/PlanterCard.astro";
import Icon from "../../components/Icon.astro";
import { planters } from "../../data/planters";

const filters = [
  { tag: "all", label: "All" },
  { tag: "beginner", label: "Beginner" },
  { tag: "herbs", label: "Herbs" },
  { tag: "design", label: "Design-led" },
  { tag: "hydroponic", label: "Hydroponic" },
  { tag: "vertical", label: "Vertical" },
];
---
<Layout title="AI Planter Catalog — GaiaVerity" desc="Every smart planter we trust, vetted and ranked by the GaiaVerity team.">
  <section class="bg-gaia-pale px-5 pt-6 pb-8">
    <div class="max-w-[1100px] mx-auto">

      <!-- Breadcrumb -->
      <nav class="flex flex-wrap gap-2 font-sans text-[13px] py-5" style="color:#5c7962" aria-label="Breadcrumb">
        <a href="/planters" class="hover:text-gaia-gold transition-colors">Shop</a>
        <span class="opacity-50">/</span>
        <span>Catalog</span>
      </nav>

      <!-- Collection header -->
      <div class="flex flex-wrap gap-6 justify-between items-end mb-8">
        <div class="max-w-[680px]">
          <p class="font-sans text-[11px] font-semibold tracking-[0.18em] uppercase mb-3" style="color:#c98633">AI Planter Catalog</p>
          <h1 class="font-sans text-[clamp(38px,5.6vw,68px)] font-bold leading-[1.05] tracking-[-0.02em] text-gaia-ink my-3">Every smart planter we trust</h1>
          <p class="font-serif text-[clamp(16px,1.5vw,19px)] text-gaia-forest leading-[1.6]">Smart planters that water, feed and monitor your plants — vetted and ranked by the GaiaVerity team.</p>
        </div>
        <span class="inline-flex items-center gap-1.5 font-sans text-[11px] font-semibold tracking-[0.05em] uppercase text-gaia-gold rounded-full px-3 py-1.5" style="background:rgba(201,134,51,.10); border:1px solid rgba(201,134,51,.35)">
          <Icon name="shield" /> {planters.length} vetted picks
        </span>
      </div>

      <!-- Toolbar: filter pills + sort -->
      <div class="flex flex-wrap gap-3 justify-between items-center py-4 border-t border-b" style="border-color:rgba(128,190,164,.5)">
        <div class="flex flex-wrap gap-2" id="tagPills">
          {filters.map((f, i) => (
            <button
              class:list={[
                "rounded-full px-4 py-2 text-[13px] font-sans transition-colors border",
                i === 0 ? "bg-gaia-sage text-gaia-ink border-transparent" : "bg-transparent text-gaia-forest border-gaia-border hover:text-gaia-ink",
              ]}
              data-tag={f.tag}
            >
              {f.label}
            </button>
          ))}
        </div>
        <div class="flex items-center gap-2 font-sans text-[13px]" style="color:#5c7962">
          <label for="sortBy">Sort</label>
          <select id="sortBy" class="rounded-xl px-3 py-2 font-sans text-[13.5px] border" style="background:#f7f5f0; color:#23312b; border-color:#80bea4">
            <option>Featured</option>
            <option>Price: low to high</option>
            <option>Price: high to low</option>
            <option>Top rated</option>
            <option>Highest commission</option>
          </select>
        </div>
      </div>

      <!-- Product grid -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mt-6" id="catalogGrid">
        {planters.map((p, i) => <PlanterCard product={p} feature={i === 0} />)}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var pills = document.getElementById("tagPills");
      var grid = document.getElementById("catalogGrid");
      if (!pills || !grid) return;
      pills.addEventListener("click", function (e) {
        var btn = e.target.closest("button");
        if (!btn) return;
        pills.querySelectorAll("button").forEach(function (b) {
          b.className = "rounded-full px-4 py-2 text-[13px] font-sans transition-colors border bg-transparent text-gaia-forest border-gaia-border hover:text-gaia-ink";
        });
        btn.className = "rounded-full px-4 py-2 text-[13px] font-sans transition-colors border bg-gaia-sage text-gaia-ink border-transparent";
        var tag = btn.getAttribute("data-tag");
        grid.querySelectorAll("article").forEach(function (card) {
          var tags = (card.getAttribute("data-tags") || "").split(" ");
          card.style.display = tag === "all" || tags.indexOf(tag) !== -1 ? "" : "none";
        });
      });
    })();
  </script>
</Layout>
