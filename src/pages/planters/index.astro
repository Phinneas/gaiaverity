---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import PlanterCard from "../../components/PlanterCard.astro";
import Icon from "../../components/Icon.astro";
import AskAI from "../../components/AskAI.astro";
import { planters } from "../../data/planters";

const topPick = planters.find((p) => p.recommended) ?? planters[0];
---
<Layout title="AI Planters — GaiaVerity" desc="The smart planters we'd actually put in our own homes — vetted by GaiaVerity for craft, intelligence and longevity.">

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="bg-gaia-pale px-5 pt-6 pb-5">
    <div class="max-w-[1100px] mx-auto grid md:grid-cols-2 gap-4 items-stretch" style="min-height:520px">
      <div class="bg-gaia-paper rounded-3xl p-10 lg:p-14 flex flex-col justify-between" style="background:#f7f5f0">
        <div>
          <p class="font-sans text-[11px] font-semibold tracking-[0.18em] uppercase mb-6" style="color:#c98633">Considered, vetted, alive.</p>
          <h1 class="font-sans text-[clamp(32px,4.5vw,56px)] font-semibold leading-[1.08] tracking-[-0.02em] mb-6" style="color:#23312b">
            Plants that practically<br/>raise
            <span style="color:#5c7962">themselves.</span>
          </h1>
          <p class="font-serif text-[16px] leading-[1.8] max-w-[340px]" style="color:#5c7962">
            The smart planters we'd actually put in our own homes — water, light and care handled, so you get the calm of a thriving garden without the guesswork.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 mt-10">
          <a href="/planters/catalog" class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-[14px] font-sans font-semibold transition-colors" style="background:#c98633; color:#23312b;">
            Shop the catalog
            <Icon name="arrow" class="arw" />
          </a>
          <a href={`/planters/${topPick.slug}`} class="inline-flex items-center rounded-full border px-6 py-3.5 text-[14px] font-sans transition-colors" style="border-color:#80bea4; color:#5c7962;">
            See our top pick
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-3 mt-6 font-sans text-[13px]" style="color:#5c7962">
          <span class="inline-flex items-center gap-1.5"><Icon name="check-circle" /> 1,200+ plants tracked</span>
          <span class="w-[5px] h-[5px] rounded-full bg-gaia-gold"></span>
          <span>Independent reviews</span>
          <span class="w-[5px] h-[5px] rounded-full bg-gaia-gold"></span>
          <span>No add-to-cart pressure</span>
        </div>
      </div>

      <!-- Hero visual -->
      <div class="rounded-3xl overflow-hidden relative flex items-end p-6" style="min-height:420px; background:radial-gradient(120% 95% at 72% 12%,rgba(128,190,164,.4),transparent 58%),linear-gradient(160deg,#EEF4F0,#E0EBE3); border:1px solid rgba(128,190,164,.5)">
        <span class="absolute top-8 left-8 w-14 h-14 text-gaia-forest opacity-90"><Icon name="leaf" /></span>
        <div class="relative w-full rounded-2xl p-5 flex justify-between items-center gap-4" style="background:rgba(255,255,255,.92); backdrop-filter:blur(8px); border:1px solid rgba(128,190,164,.5)">
          <div>
            <span class="inline-flex items-center gap-1.5 font-sans text-[11px] font-semibold tracking-[0.05em] uppercase text-gaia-gold rounded-full px-3 py-1.5 mb-2.5" style="background:rgba(201,134,51,.10); border:1px solid rgba(201,134,51,.35)">
              <Icon name="shield" /> GaiaVerity recommended
            </span>
            <div class="font-sans font-semibold text-[18px] text-gaia-ink">{topPick.name}</div>
            <div class="text-[12.5px] mt-0.5" style="color:#5c7962">Best for {topPick.bestFor}</div>
          </div>
          <div class="text-right">
            <div class="font-sans font-bold text-[19px] text-gaia-gold">{topPick.priceRange}</div>
            <div class="text-[12.5px] mt-0.5" style="color:#5c7962">{topPick.rating} ★</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Bento features ───────────────────────────────── -->
  <section class="bg-gaia-pale px-5 pb-5">
    <div class="max-w-[1100px] mx-auto" style="display:grid; grid-template-columns:repeat(3,1fr); grid-template-rows:280px 220px; gap:16px;">
      <!-- Autonomous irrigation — large, 2 cols -->
      <div class="rounded-3xl p-10 flex flex-col justify-between reveal" style="grid-column:span 2; background:#23312b; overflow:hidden; position:relative;">
        <span class="w-10 h-10 text-gaia-forest"><Icon name="drop" /></span>
        <div>
          <h3 class="font-sans font-semibold text-[20px] tracking-[-0.01em] mb-2" style="color:#f7f5f0">Autonomous irrigation</h3>
          <p class="font-serif text-[14.5px] leading-[1.7]" style="color:#80bea4">Sensors read soil moisture and water on schedule — no guesswork, no drowning.</p>
        </div>
      </div>

      <!-- 98.3% stat — gold -->
      <div class="rounded-3xl p-6 flex flex-col justify-between reveal" style="background:#c98633;">
        <span class="font-sans text-[11px] tracking-[0.14em] uppercase font-semibold" style="color:rgba(35,49,43,.65)">Tracked outcome</span>
        <div>
          <div class="font-sans font-bold text-[clamp(34px,4vw,52px)] tracking-[-0.02em] leading-none text-gaia-ink">98.3%</div>
          <p class="mt-2 text-[14.5px] font-serif" style="color:#5c3a0f">grow-success across 1,200 monitored plants</p>
        </div>
      </div>

      <!-- Live health tracking -->
      <div class="rounded-3xl p-6 flex flex-col justify-between reveal" style="background:#eef4f0; border:1px solid rgba(128,190,164,.5)">
        <span class="w-10 h-10 text-gaia-forest"><Icon name="pulse" /></span>
        <h3 class="font-sans font-semibold text-[16px] text-gaia-ink">Live health tracking</h3>
      </div>

      <!-- Full-spectrum light -->
      <div class="rounded-3xl p-6 flex flex-col justify-between reveal" style="background:#eef4f0; border:1px solid rgba(128,190,164,.5)">
        <span class="w-10 h-10 text-gaia-forest"><Icon name="sun" /></span>
        <h3 class="font-sans font-semibold text-[16px] text-gaia-ink">Full-spectrum light</h3>
      </div>

      <!-- Quote — full width -->
      <div class="rounded-3xl p-8 flex flex-col justify-between reveal" style="grid-column:span 3; background:#eef4f0; border:1px solid rgba(128,190,164,.5)">
        <p class="font-serif italic text-[clamp(17px,1.7vw,22px)] leading-[1.4] text-gaia-ink">&ldquo;Finally kept basil alive through a whole winter.&rdquo;</p>
        <p class="font-sans text-[13px]" style="color:#5c7962"><b class="text-gaia-ink font-semibold">r/IndoorGarden</b> · Reddit</p>
      </div>
    </div>
  </section>

  <!-- ── Featured products ────────────────────────────── -->
  <section class="bg-gaia-pale px-5 pb-5">
    <div class="max-w-[1100px] mx-auto">
      <div class="flex flex-wrap justify-between items-end gap-4 mb-8 reveal">
        <div class="max-w-[620px]">
          <p class="font-sans text-[11px] font-semibold tracking-[0.18em] uppercase mb-3" style="color:#c98633">The shortlist</p>
          <h2 class="font-sans text-[clamp(27px,4vw,44px)] font-semibold leading-[1.1] tracking-[-0.018em] text-gaia-ink">Five planters worth your shelf.</h2>
          <p class="font-serif text-[clamp(16px,1.5vw,19px)] text-gaia-forest mt-3 leading-[1.6]">Hand-picked and stress-tested. The first is our current top pick.</p>
        </div>
        <a href="/planters/catalog" class="inline-flex items-center gap-2 rounded-full border px-6 py-3 text-[14px] font-sans font-semibold transition-colors" style="border-color:#5c7962; color:#23312b;">
          View full catalog <Icon name="arrow" class="arw" />
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {planters.map((p, i) => <PlanterCard product={p} feature={i === 0} />)}
      </div>
    </div>
  </section>

  <!-- ── Social proof ─────────────────────────────────── -->
  <section class="bg-gaia-pale px-5 pb-5">
    <div class="max-w-[1100px] mx-auto text-center mb-8 reveal">
      <p class="font-sans text-[11px] font-semibold tracking-[0.18em] uppercase mb-3" style="color:#c98633">Loved by growers</p>
      <h2 class="font-sans text-[clamp(27px,4vw,44px)] font-semibold leading-[1.1] tracking-[-0.018em] text-gaia-ink">Join 2,400+ gardeners who upgraded their plant care.</h2>
    </div>
    <div class="max-w-[1100px] mx-auto grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Average rating -->
      <div class="rounded-3xl p-6 flex flex-col justify-between reveal" style="background:#c98633;">
        <span class="font-sans text-[11px] tracking-[0.14em] uppercase font-semibold" style="color:rgba(35,49,43,.65)">Average rating</span>
        <div>
          <div class="font-sans font-bold text-[clamp(34px,4vw,52px)] tracking-[-0.02em] leading-none text-gaia-ink">4.9★</div>
          <p class="mt-1 text-[14.5px] font-serif" style="color:#5c3a0f">across 2,400+ reader reviews</p>
        </div>
      </div>
      <!-- Quote 1 -->
      <div class="rounded-3xl p-8 flex flex-col justify-between lg:col-span-2 reveal" style="background:#eef4f0; border:1px solid rgba(128,190,164,.5)">
        <p class="font-serif italic text-[clamp(17px,1.7vw,22px)] leading-[1.4] text-gaia-ink">&ldquo;I travel constantly and my herbs have never looked better. The app does everything.&rdquo;</p>
        <p class="font-sans text-[13px]" style="color:#5c7962"><b class="text-gaia-ink font-semibold">Maya R.</b> · Verified buyer</p>
      </div>
      <!-- Quote 2 -->
      <div class="rounded-3xl p-8 flex flex-col justify-between reveal" style="background:#eef4f0; border:1px solid rgba(128,190,164,.5)">
        <p class="font-serif italic text-[16px] leading-[1.4] text-gaia-ink">&ldquo;Set it up in ten minutes and forgot about it.&rdquo;</p>
        <p class="font-sans text-[13px]" style="color:#5c7962"><b class="text-gaia-ink font-semibold">Devin K.</b></p>
      </div>
      <!-- Quote 3 -->
      <div class="rounded-3xl p-8 flex flex-col justify-between lg:col-span-2 reveal" style="background:#eef4f0; border:1px solid rgba(128,190,164,.5)">
        <p class="font-serif italic text-[clamp(17px,1.7vw,22px)] leading-[1.4] text-gaia-ink">&ldquo;The GaiaVerity reviews are refreshingly honest — they talk about the cons too.&rdquo;</p>
        <p class="font-sans text-[13px]" style="color:#5c7962"><b class="text-gaia-ink font-semibold">Priya S.</b> · Newsletter reader</p>
      </div>
    </div>
    <div class="max-w-[1100px] mx-auto mt-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-2 reveal">
      <span class="font-sans text-[12px] tracking-[0.2em] uppercase font-semibold text-gaia-forest w-full text-center mb-1">As featured across</span>
      <span class="font-sans font-semibold text-gaia-forest text-[16px] opacity-85">Shopify Collabs</span>
      <span class="font-sans font-semibold text-gaia-forest text-[16px] opacity-85">Amazon Associates</span>
      <span class="font-sans font-semibold text-gaia-forest text-[16px] opacity-85">UpPromote</span>
      <span class="font-sans font-semibold text-gaia-forest text-[16px] opacity-85">Kickbooster</span>
    </div>
  </section>

  <!-- ── Ask AI ───────────────────────────────────────── -->
  <section class="bg-gaia-pale px-5 pb-5">
    <div class="max-w-[1100px] mx-auto rounded-3xl px-10 py-8" style="background:#f7f5f0">
      <AskAI
        productName="GaiaVerity AI Planter Reviews"
        url="https://gaiaverity.com/planters"
        useCase="pick the right smart planter for my home"
        alternatives={["Amazon reviews", "manufacturer sites"]}
      />
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────── -->
  <section class="bg-gaia-pale px-5 pb-8">
    <div class="max-w-[1100px] mx-auto rounded-3xl px-10 py-14 text-center" style="background:#23312b">
      <p class="font-sans text-[11px] font-semibold tracking-[0.18em] uppercase mb-3" style="color:#c98633">Your garden, upgraded</p>
      <h2 class="font-sans text-[clamp(27px,4vw,44px)] font-semibold leading-[1.1] tracking-[-0.018em] mb-4" style="color:#f7f5f0">Ready to transform your garden?</h2>
      <p class="font-serif text-[clamp(16px,1.5vw,19px)] leading-[1.6] max-w-[600px] mx-auto mb-8" style="color:#80bea4">Compare all five planters side by side and find the one that fits your space, light and budget — in under two minutes.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/planters/catalog" class="inline-flex items-center gap-2 rounded-full px-7 py-4 text-[15px] font-sans font-semibold transition-colors" style="background:#c98633; color:#23312b;">
          Compare planters <Icon name="arrow" class="arw" />
        </a>
        <a href={`/planters/${topPick.slug}`} class="inline-flex items-center rounded-full border px-7 py-4 text-[15px] font-sans font-semibold transition-colors" style="border-color:rgba(247,245,240,.5); color:#f7f5f0;">
          See the top pick
        </a>
      </div>
    </div>
  </section>

  <!-- Scroll reveal -->
  <script is:inline>
  (function(){
    var els=document.querySelectorAll(".reveal");
    if("IntersectionObserver" in window){
      var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.style.opacity="1";x.target.style.transform="none";io.unobserve(x.target)}})},{threshold:.12,rootMargin:"0px 0px -40px 0px"});
      els.forEach(function(el){io.observe(el)});
    }else{
      els.forEach(function(el){el.style.opacity="1";el.style.transform="none"});
    }
  })();
  </script>
  <style>
    .reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1); }
    @media (prefers-reduced-motion:reduce) { .reveal { opacity: 1 !important; transform: none !important; transition: none !important; } }
  </style>
</Layout>
