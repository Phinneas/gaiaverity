---
import Layout from "@/layouts/Layout.astro";
import "@/styles/planters.css";
import PlanterCard from "../../components/PlanterCard.astro";
import Icon from "../../components/Icon.astro";
import AskAI from "../../components/AskAI.astro";
import { planters } from "../../data/planters";

const topPick = planters.find((p) => p.recommended) ?? planters[0];
---
<Layout title="AI Planters — GaiaVerity" desc="The smart planters we'd actually put in our own homes — vetted by GaiaVerity for craft, intelligence and longevity.">
<div class="gv-shop" id="gvShop">

  <!-- HERO -->
  <section class="hero">
    <div class="gv-container">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Considered, vetted, alive.</span>
          <h1 class="h1">Plants that practically raise themselves.</h1>
          <p class="lead">The smart planters we'd actually put in our own homes — water, light and care handled, so you get the calm of a thriving garden without the guesswork.</p>
          <div class="hero-actions">
            <a href="/planters/catalog" class="btn btn-primary btn-lg">Shop the catalog <Icon name="arrow" class="arw" /></a>
            <a href={`/planters/${topPick.slug}`} class="btn btn-ghost btn-lg">See our top pick</a>
          </div>
          <div class="hero-trust">
            <span><Icon name="check-circle" /> 1,200+ plants tracked</span>
            <span class="dot"></span><span>Independent reviews</span>
            <span class="dot"></span><span>No add-to-cart pressure</span>
          </div>
        </div>
        <div class="hero-visual">
          <Icon name="leaf" class="leaf-mark" />
          <div class="hero-card">
            <div>
              <span class="badge-stamp" style="margin-bottom:10px"><Icon name="shield" /> GaiaVerity recommended</span>
              <div class="hc-name">{topPick.name}</div>
              <div class="hc-meta">Best for {topPick.bestFor}</div>
            </div>
            <div style="text-align:right">
              <div class="hc-price">{topPick.priceRange}</div>
              <div class="hc-meta">{topPick.rating} ★</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY (bento) -->
  <section class="section">
    <div class="gv-container">
      <div class="section-head reveal">
        <span class="eyebrow">Why GaiaVerity</span>
        <h2 class="h2">Care that runs itself.</h2>
        <p class="lead">Every planter we feature earns its place across three things that actually matter: autonomy, intelligence and survival.</p>
      </div>
      <div class="bento">
        <div class="tile tile-glow tile--tall reveal">
          <span class="tile-icon"><Icon name="drop" /></span>
          <div>
            <h3 class="tile-title">Autonomous irrigation</h3>
            <p class="muted" style="margin-top:8px;font-size:14.5px">Sensors read soil moisture and water on schedule — no guesswork, no drowning.</p>
          </div>
        </div>
        <div class="tile tile--gold tile--wide reveal">
          <span class="tile-micro">Tracked outcome</span>
          <div><div class="tile-num">98.3%</div><p style="margin-top:8px;font-size:14.5px">grow-success across 1,200 monitored plants</p></div>
        </div>
        <div class="tile tile--sm reveal">
          <span class="tile-icon"><Icon name="pulse" /></span>
          <h3 class="tile-title" style="font-size:16px">Live health tracking</h3>
        </div>
        <div class="tile tile--sm reveal">
          <span class="tile-icon"><Icon name="sun" /></span>
          <h3 class="tile-title" style="font-size:16px">Full-spectrum light</h3>
        </div>
        <div class="tile quote-tile tile--full reveal">
          <p class="q">&ldquo;Finally kept basil alive through a whole winter.&rdquo;</p>
          <p class="src"><b>r/IndoorGarden</b> · Reddit</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="section">
    <div class="gv-container">
      <div class="section-head reveal" style="display:flex;justify-content:space-between;align-items:flex-end;max-width:100%;flex-wrap:wrap;gap:16px">
        <div style="max-width:620px">
          <span class="eyebrow">The shortlist</span>
          <h2 class="h2">Five planters worth your shelf.</h2>
          <p class="lead">Hand-picked and stress-tested. The first is our current top pick.</p>
        </div>
        <a href="/planters/catalog" class="btn btn-ghost">View full catalog <Icon name="arrow" class="arw" /></a>
      </div>
      <div class="product-grid">
        {planters.map((p, i) => <PlanterCard product={p} feature={i === 0} />)}
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF -->
  <section class="section section--tight">
    <div class="gv-container">
      <div class="section-head center mx-auto reveal" style="text-align:center">
        <span class="eyebrow">Loved by growers</span>
        <h2 class="h2">Join 2,400+ gardeners who upgraded their plant care.</h2>
      </div>
      <div class="proof-grid">
        <div class="tile tile--gold tile--sm reveal">
          <span class="tile-micro">Average rating</span>
          <div><div class="tile-num">4.9★</div><p style="margin-top:6px;font-size:14.5px">across 2,400+ reader reviews</p></div>
        </div>
        <div class="tile quote-tile tile--wide reveal">
          <p class="q">&ldquo;I travel constantly and my herbs have never looked better. The app does everything.&rdquo;</p>
          <p class="src"><b>Maya R.</b> · Verified buyer</p>
        </div>
        <div class="tile quote-tile tile--sm reveal">
          <p class="q" style="font-size:16px">&ldquo;Set it up in ten minutes and forgot about it.&rdquo;</p>
          <p class="src"><b>Devin K.</b></p>
        </div>
        <div class="tile quote-tile tile--wide reveal">
          <p class="q">&ldquo;The GaiaVerity reviews are refreshingly honest — they talk about the cons too.&rdquo;</p>
          <p class="src"><b>Priya S.</b> · Newsletter reader</p>
        </div>
      </div>
      <div class="logos reveal">
        <span class="kicker" style="width:100%;text-align:center;margin-bottom:6px">As featured across</span>
        <span>Shopify Collabs</span><span>Amazon Associates</span><span>UpPromote</span><span>Kickbooster</span>
      </div>
    </div>
  </section>

  <!-- Ask AI -->
  <section class="section section--tight">
    <div class="gv-container">
      <AskAI
        productName="GaiaVerity AI Planter Reviews"
        url="https://gaiaverity.com/planters"
        useCase="pick the right smart planter for my home"
        alternatives={["Amazon reviews", "manufacturer sites"]}
      />
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="gv-container">
      <div class="cta-banner reveal">
        <span class="eyebrow">Your garden, upgraded</span>
        <h2 class="h2">Ready to transform your garden?</h2>
        <p class="lead">Compare all five planters side by side and find the one that fits your space, light and budget — in under two minutes.</p>
        <div class="cta-actions">
          <a href="/planters/catalog" class="btn btn-primary btn-lg">Compare planters <Icon name="arrow" class="arw" /></a>
          <a href={`/planters/${topPick.slug}`} class="btn btn-ghost btn-lg">See the top pick</a>
        </div>
      </div>
    </div>
  </section>

</div>
<script is:inline>
(function(){var s=document.getElementById("gvShop")||document.querySelector(".gv-shop");if(!s)return;s.classList.add("ready");var els=s.querySelectorAll(".reveal");if("IntersectionObserver" in window){var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add("in");io.unobserve(x.target)}})},{threshold:.12,rootMargin:"0px 0px -40px 0px"});els.forEach(function(el){io.observe(el)})}else{els.forEach(function(el){el.classList.add("in")}})();
</script>
</Layout>
