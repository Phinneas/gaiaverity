---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import "@/styles/planters.css";
import PlanterCard from "../../components/PlanterCard.astro";
import Icon from "../../components/Icon.astro";
import Stars from "../../components/Stars.astro";
import { planters, relatedPlanters, type Planter } from "../../data/planters";

export function getStaticPaths() {
  return planters.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props { product: Planter; }
const { product: p } = Astro.props;
const related = relatedPlanters(p.slug, 3);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<Layout title={`${p.name} review — GaiaVerity`} desc={p.verdict}>
<div class="gv-shop">

  <!-- TOP -->
  <section class="section section--tight">
    <div class="gv-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/planters">Shop</a><span class="sep">/</span>
        <a href="/planters/catalog">Catalog</a><span class="sep">/</span>
        <span>{p.name}</span>
      </nav>

      <div class="pd-top">
        <div class="pd-gallery">
          <div class="pd-main-img" style={p.mediaTint ? `background:${p.mediaTint}` : undefined}>
            {p.image ? <img src={p.image} alt={p.name} /> : <Icon name="leaf" class="leaf-mark" />}
          </div>
          <div class="pd-thumbs">
            {[0, 1, 2].map(() => <div class="pd-thumb" style={p.mediaTint ? `background:${p.mediaTint}` : undefined}></div>)}
          </div>
        </div>

        <div class="pd-info">
          <div class="pd-stamp-row">
            {p.recommended && <span class="badge-stamp"><Icon name="shield" /> GaiaVerity Recommended</span>}
            <span class="kicker">via {p.platform}</span>
          </div>
          <h1 class="h1">{p.name}</h1>
          <Stars rating={p.rating} count={p.reviews} showText={true} />
          <p class="pd-verdict">{p.verdict}</p>

          <div class="spec-card">
            <div class="spec"><span class="k">Price range</span><span class="v gold">{p.priceRange}</span></div>
            <div class="spec"><span class="k">Best for</span><span class="v">{cap(p.bestFor)}</span></div>
            <div class="spec"><span class="k">Platform</span><span class="v">{p.platform}</span></div>
            <div class="spec"><span class="k">Commission</span><span class="v gold">{p.commission}</span></div>
          </div>

          <div class="pd-cta">
            <a href={p.affiliateUrl} target="_blank" rel="sponsored nofollow noopener" class="btn btn-primary btn-lg btn-block">Buy now <Icon name="external" /></a>
            <div class="disclosure"><Icon name="info" /> We earn a small commission at no extra cost to you.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OVERVIEW + FEATURES -->
  <section class="section section--tight">
    <div class="gv-container">
      <div class="section-head reveal"><span class="eyebrow">The verdict</span><h2 class="h2">Why it earns the stamp</h2></div>
      <div class="pd-overview-grid">
        <div class="rte reveal">
          {p.description.map((para) => <p>{para}</p>)}
        </div>
        <div class="tile reveal" style="display:block">
          <span class="tile-micro">Key features</span>
          <ul class="feature-list">
            {p.features.map((f) => <li><Icon name="check" /><span>{f}</span></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PROS & CONS -->
  <section class="section section--tight">
    <div class="gv-container">
      <div class="section-head reveal"><span class="eyebrow">Honest take</span><h2 class="h2">Pros &amp; cons</h2></div>
      <div class="proscons">
        <div class="pc-card pros reveal">
          <h4><Icon name="check-circle" /> What we love</h4>
          <ul>{p.pros.map((x) => <li><Icon name="check" /><span>{x}</span></li>)}</ul>
        </div>
        <div class="pc-card cons reveal">
          <h4><Icon name="minus-circle" /> Worth weighing</h4>
          <ul>{p.cons.map((x) => <li><Icon name="minus-circle" /><span>{x}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section section--tight">
    <div class="gv-container">
      <div class="section-head reveal"><span class="eyebrow">How it stacks up</span><h2 class="h2">{p.name} vs. the field</h2></div>
      <div class="compare-wrap reveal">
        <table class="compare">
          <thead><tr><th>Planter</th><th>Price</th><th>Best for</th><th>Rating</th><th></th></tr></thead>
          <tbody>
            {planters.map((x) => (
              <tr class={x.slug === p.slug ? "is-current" : undefined}>
                <th scope="row">{x.name}{x.slug === p.slug && <span class="mini-stamp"> · this pick</span>}</th>
                <td class="val">{x.priceRange}</td>
                <td class="val">{cap(x.bestFor)}</td>
                <td class="val">{x.rating} ★</td>
                <td><a href={`/planters/${x.slug}`}>View <Icon name="arrow" class="arw" /></a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- VIDEO + REVIEW -->
  <section class="section section--tight">
    <div class="gv-container">
      <div class="pd-media-grid" style="grid-template-columns:1.4fr .9fr">
        <div class="video-embed reveal" style="display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px">
          <span style="width:74px;height:74px;border-radius:50%;background:rgba(255,255,255,.7);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--accent)"><Icon name="play" /></span>
          <span class="kicker">Add a video review (YouTube / TikTok)</span>
        </div>
        <div class="tile quote-tile reveal" style="justify-content:center">
          <Stars rating={5} />
          <p class="q">&ldquo;{p.review.quote}&rdquo;</p>
          <p class="src"><b>{p.review.author}</b> · {p.review.source}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--tight">
    <div class="gv-container">
      <div class="cta-banner reveal">
        <span class="eyebrow">Ready when you are</span>
        <h2 class="h2">Get the {p.name}</h2>
        <p class="lead">You'll be taken to our trusted retail partner. Reader-exclusive rates may apply.</p>
        <div class="cta-actions">
          <a href={p.affiliateUrl} target="_blank" rel="sponsored nofollow noopener" class="btn btn-primary btn-lg">Buy now <Icon name="external" /></a>
          <a href="/planters/catalog" class="btn btn-ghost btn-lg">Compare alternatives</a>
        </div>
        <div class="disclosure" style="justify-content:center;margin-top:18px"><Icon name="info" /> We earn a small commission at no extra cost to you.</div>
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="section section--tight">
    <div class="gv-container">
      <div class="section-head reveal"><span class="eyebrow">Keep exploring</span><h2 class="h2">Related planters</h2></div>
      <div class="product-grid">
        {related.map((x) => <PlanterCard product={x} />)}
      </div>
    </div>
  </section>

</div>
<script is:inline>
(function(){var s=document.querySelector(".gv-shop");if(!s)return;s.classList.add("ready");var els=s.querySelectorAll(".reveal");if("IntersectionObserver" in window){var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add("in");io.unobserve(x.target)}})},{threshold:.12,rootMargin:"0px 0px -40px 0px"});els.forEach(function(el){io.observe(el)})}else{els.forEach(function(el){el.classList.add("in")}})();
</script>
</Layout>
