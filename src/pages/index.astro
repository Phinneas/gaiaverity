---
import Container from "@/components/container.astro";
import Postlist from "@/components/postlist.astro";
import Layout from "@/layouts/Layout.astro";
import { getBlogPosts } from "@/lib/sonicjs";

const allPosts = await getBlogPosts();
const featuredPosts = allPosts.slice(0, 3);
const recentPosts  = allPosts.slice(3, 9);

const topics = [
  { title: "Mushrooms & Fungi",     slug: "mushrooms",   emoji: "🍄", desc: "Identify what's growing in your lawn and understand the soil networks beneath it." },
  { title: "Lawn Alternatives",     slug: "lawn",        emoji: "🌿", desc: "Clover, wildflowers, and low-maintenance ground covers that outperform turf." },
  { title: "Native Plants",         slug: "native",      emoji: "🌸", desc: "Plants built for your region — less work, better for pollinators, lower input." },
  { title: "Drought-Tolerant",      slug: "drought",     emoji: "☀️", desc: "Gardens that thrive on less water. Practical choices for dry summers." },
  { title: "Small Space Gardens",   slug: "small-space", emoji: "🪴", desc: "Vertical beds, containers, and smart layouts for patios and tight yards." },
  { title: "Sustainable Methods",   slug: "sustainable", emoji: "♻️", desc: "No-dig beds, compost, and practices that build your soil year over year." },
];
---

<Layout
  title=""
  desc="Sustainable lawn care, native plants, garden mushrooms, and low-input growing — for real gardeners in real spaces.">

  <!-- ── Hero ── -->
  <section class="bg-gaia-cream border-b border-gaia-tan/40">
    <Container class="py-16 lg:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold tracking-widest uppercase text-gaia-sage mb-5">
          Garden &amp; Sustainable Living
        </p>
        <h1 class="text-5xl lg:text-6xl font-bold leading-[1.08] tracking-tight text-gaia-soil mb-6">
          Grow something<br/>real.
        </h1>
        <p class="text-lg text-gaia-soil/70 leading-relaxed mb-10 max-w-xl">
          GaiaVerity is a gardening resource for people who want to work with their land —
          not against it. From lawn fungi to drought-tolerant borders, we cover
          what actually works in backyard-scale spaces.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/blog"
            class="inline-flex items-center px-6 py-3 bg-gaia-terracotta text-white font-semibold rounded-lg hover:bg-gaia-tan transition-colors text-sm">
            Browse All Articles
          </a>
          <a
            href="/about"
            class="inline-flex items-center px-6 py-3 border border-gaia-tan text-gaia-soil font-medium rounded-lg hover:bg-gaia-tan/20 transition-colors text-sm">
            About GaiaVerity
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- ── Trust bar ── -->
  <section class="bg-gaia-soil text-gaia-cream/80 py-4">
    <Container class="py-0">
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-2 text-xs font-medium tracking-wide uppercase text-center">
        <span>🌱 Sustainable Practices</span>
        <span class="hidden sm:block text-gaia-sage">·</span>
        <span>🏡 Backyard-Scale Advice</span>
        <span class="hidden sm:block text-gaia-sage">·</span>
        <span>🌎 Low-Input Growing</span>
        <span class="hidden sm:block text-gaia-sage">·</span>
        <span>🍄 Mushroom Identification</span>
      </div>
    </Container>
  </section>

  <!-- ── Featured posts ── -->
  {featuredPosts.length > 0 && (
    <section class="py-16">
      <Container>
        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="text-xs font-semibold tracking-widest uppercase text-gaia-terracotta mb-1">Latest</p>
            <h2 class="text-2xl font-bold text-gaia-soil dark:text-white">From the Garden</h2>
          </div>
          <a href="/blog" class="text-sm font-medium text-gaia-sage hover:text-gaia-terracotta transition-colors">
            View all →
          </a>
        </div>
        <!-- First post large, rest stacked -->
        <div class="grid lg:grid-cols-5 gap-8">
          <div class="lg:col-span-3">
            <Postlist post={featuredPosts[0]} aspect="landscape" preloadImage={true} />
          </div>
          <div class="lg:col-span-2 flex flex-col gap-8">
            {featuredPosts.slice(1).map((post) => (
              <Postlist post={post} aspect="landscape" preloadImage={false} />
            ))}
          </div>
        </div>
      </Container>
    </section>
  )}

  <!-- ── Browse by topic ── -->
  <section class="py-16 bg-gaia-cream/60 border-y border-gaia-tan/30">
    <Container>
      <div class="mb-10">
        <p class="text-xs font-semibold tracking-widest uppercase text-gaia-terracotta mb-1">Explore</p>
        <h2 class="text-2xl font-bold text-gaia-soil dark:text-white">Browse by Topic</h2>
        <p class="mt-2 text-gaia-soil/60 max-w-lg">
          Whether you're dealing with fairy rings, planning a no-dig bed, or looking for
          plants that survive your dry summers — find it here.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {topics.map((topic) => (
          <a
            href={`/blog?category=${topic.slug}`}
            class="group flex items-start gap-4 p-5 rounded-xl bg-white border border-gaia-tan/40 hover:border-gaia-terracotta hover:shadow-sm transition-all">
            <span class="text-2xl mt-0.5 flex-shrink-0">{topic.emoji}</span>
            <div>
              <h3 class="font-semibold text-gaia-soil group-hover:text-gaia-terracotta transition-colors mb-1">
                {topic.title}
              </h3>
              <p class="text-sm text-gaia-soil/60 leading-snug">{topic.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- ── More to read ── -->
  {recentPosts.length > 0 && (
    <section class="py-16">
      <Container>
        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="text-xs font-semibold tracking-widest uppercase text-gaia-terracotta mb-1">More</p>
            <h2 class="text-2xl font-bold text-gaia-soil dark:text-white">Keep Reading</h2>
          </div>
          <a href="/blog" class="text-sm font-medium text-gaia-sage hover:text-gaia-terracotta transition-colors">
            View all →
          </a>
        </div>
        <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
          {recentPosts.map((post) => (
            <Postlist post={post} aspect="square" />
          ))}
        </div>
      </Container>
    </section>
  )}

  <!-- ── Closing CTA ── -->
  <section class="bg-gaia-soil py-20">
    <Container>
      <div class="max-w-xl">
        <p class="text-gaia-sage text-sm font-semibold tracking-widest uppercase mb-4">The GaiaVerity Way</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-5 leading-tight">
          Your backyard is an ecosystem.<br/>Work with it.
        </h2>
        <p class="text-gaia-cream/70 text-lg mb-8 leading-relaxed">
          Practical guides grounded in soil health, seasonal timing, and the reality
          of gardening in a real space with real constraints.
        </p>
        <a
          href="/blog"
          class="inline-flex items-center px-7 py-3 bg-gaia-terracotta text-white font-semibold rounded-lg hover:bg-gaia-tan transition-colors">
          Explore the Archive
        </a>
      </div>
    </Container>
  </section>

</Layout>
