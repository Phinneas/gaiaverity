---
import Layout from "@/layouts/Layout.astro";
import Postlist from "@/components/postlist.astro";
import { getBlogPosts } from "@/lib/sonicjs";

const allPosts = await getBlogPosts();
const recentPosts = allPosts.slice(0, 6);

const topics = [
  { label: "Lawn mushrooms",              href: "/blog?category=mushrooms" },
  { label: "Drought-resistant ground cover", href: "/blog?category=drought" },
  { label: "Native plant gardening",      href: "/blog?category=native" },
  { label: "Vertical gardens",            href: "/blog?category=small-space" },
  { label: "Organic lawn care",           href: "/blog?category=sustainable" },
  { label: "Pest & weed control",         href: "/blog?category=pest-control" },
  { label: "Soil prep & composting",      href: "/blog?category=soil" },
  { label: "Shade gardening",             href: "/blog?category=shade" },
  { label: "Rain garden design",          href: "/blog?category=rain-garden" },
  { label: "Fire-resistant plants",       href: "/blog?category=fire-resistant" },
];
---

<Layout
  title=""
  desc="Real, practical gardening advice for home gardeners — from lawn mushrooms to drought-tolerant borders.">

  <div class="max-w-[720px] mx-auto px-8 pb-16">

    <!-- ── Hero ── -->
    <section class="py-12 border-b border-black/10">
      <p class="text-[11px] font-semibold tracking-[0.12em] uppercase text-gaia-mid mb-4">
        GaiaVerity — Gardening &amp; Lawn Care
      </p>
      <h1 class="font-serif text-[clamp(28px,5vw,44px)] font-medium leading-[1.2] text-gray-900 mb-5">
        Grow a yard you're <em class="italic text-gaia-mid">proud of,</em><br/>
        no green thumb required.
      </h1>
      <p class="text-[17px] leading-[1.75] text-gray-600 max-w-[560px] mb-8">
        Real, practical advice for home gardeners and Pacific Northwest homeowners —
        from taming lawn mushrooms to finding the right ground cover for your soil type.
      </p>
      <div class="flex flex-wrap items-center gap-4 mb-4">
        <a
          href="/blog"
          class="inline-block bg-gaia-mid text-gaia-pale rounded-lg px-7 py-3 text-[15px] font-semibold hover:bg-gaia-dark transition-colors">
          Start reading free guides &rarr;
        </a>
        <a
          href="/about"
          class="inline-block border border-black/12 text-gray-600 rounded-lg px-5 py-3 text-[15px] font-medium hover:border-gaia-border hover:text-gaia-mid transition-colors">
          About GaiaVerity
        </a>
      </div>
      <p class="text-[13px] text-gray-400">No account needed. Just good gardening advice.</p>
    </section>

    <!-- ── Why GaiaVerity ── -->
    <section class="py-12 border-b border-black/10">
      <p class="text-[11px] font-semibold tracking-[0.1em] uppercase text-gray-400 mb-6">
        Why GaiaVerity
      </p>
      <h2 class="font-serif text-[clamp(20px,3vw,26px)] font-medium text-gray-900 mb-3">
        Gardening advice that actually matches where you live
      </h2>
      <p class="text-[15px] leading-[1.75] text-gray-600 mb-8">
        Most gardening sites treat every lawn the same. But your soil type, shade pattern,
        and local climate change everything. GaiaVerity is built around conditions real
        gardeners actually face — not idealised growing zones.
      </p>
      <ul class="flex flex-col gap-4">
        {[
          "Written for real outdoor spaces — shady plots, clay-heavy soil, dry summers, and all the rest.",
          "No jargon, no assumptions. Every guide is written so anyone can follow along and get results.",
          "Every recommendation is grounded in horticultural research, not guesswork.",
        ].map((item) => (
          <li class="flex items-start gap-3 text-[15px] leading-[1.65] text-gray-600">
            <span class="flex-shrink-0 mt-[3px] w-[22px] h-[22px] rounded-full bg-gaia-pale flex items-center justify-center">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 6l3 3 5-5" stroke="#3B6D11" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── Topics ── -->
    <section class="py-12 border-b border-black/10">
      <p class="text-[11px] font-semibold tracking-[0.1em] uppercase text-gray-400 mb-6">
        What you'll find here
      </p>
      <h2 class="font-serif text-[clamp(20px,3vw,26px)] font-medium text-gray-900 mb-3">
        From mystery mushrooms to drought-proof lawns
      </h2>
      <p class="text-[15px] leading-[1.75] text-gray-600 mb-6">
        Whether you're puzzled by white dots in your grass or ready to ditch the sprinklers
        for good, we've got a guide for it.
      </p>
      <div class="flex flex-wrap gap-2">
        {topics.map((t) => (
          <a
            href={t.href}
            class="inline-block bg-gaia-pale text-gaia-mid rounded-full px-4 py-[6px] text-[13px] font-medium hover:bg-gaia-mid hover:text-gaia-pale transition-colors">
            {t.label}
          </a>
        ))}
      </div>
    </section>

    <!-- ── Quote ── -->
    <section class="py-12 border-b border-black/10">
      <p class="text-[11px] font-semibold tracking-[0.1em] uppercase text-gray-400 mb-6">
        From the community
      </p>
      <blockquote class="border-l-[3px] border-gaia-light pl-5">
        <p class="font-serif italic text-[17px] leading-[1.65] text-gray-900 mb-2">
          "I finally understand why mushrooms keep popping up in my backyard — and what to
          do about it. The GaiaVerity guide was the first one that actually made sense."
        </p>
        <cite class="text-[13px] text-gray-400 not-italic">— A reader in Redmond, WA</cite>
      </blockquote>
    </section>

    <!-- ── Recent posts ── -->
    {recentPosts.length > 0 && (
      <section class="py-12 border-b border-black/10">
        <div class="flex items-end justify-between mb-8">
          <div>
            <p class="text-[11px] font-semibold tracking-[0.1em] uppercase text-gray-400 mb-1">
              Latest
            </p>
            <h2 class="font-serif text-[clamp(20px,3vw,26px)] font-medium text-gray-900">
              From the Garden
            </h2>
          </div>
          <a href="/blog" class="text-[13px] text-gaia-mid hover:text-gaia-dark font-medium transition-colors">
            View all →
          </a>
        </div>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {recentPosts.map((post) => (
            <Postlist post={post} aspect="square" />
          ))}
        </div>
      </section>
    )}

    <!-- ── Email signup ── -->
    <section class="py-12">
      <div class="bg-gaia-pale rounded-xl p-10">
        <h2 class="font-serif text-[clamp(20px,3vw,24px)] font-medium text-gaia-dark mb-2">
          Get seasonal tips in your inbox
        </h2>
        <p class="text-[14px] text-gaia-mid leading-[1.65] mb-5">
          The right advice at the right time — when to plant, when to prune, and when
          to just let your garden breathe. Once or twice a month.
        </p>
        <form class="flex flex-wrap gap-2" onsubmit="return false;">
          <input
            type="email"
            placeholder="your@email.com"
            aria-label="Email address"
            class="flex-1 min-w-[200px] border border-gaia-border rounded-lg px-4 py-[10px] text-[14px] text-gaia-dark bg-white focus:outline-none focus:ring-2 focus:ring-gaia-mid/30 focus:border-gaia-mid"
          />
          <button
            type="submit"
            class="bg-gaia-mid text-gaia-pale rounded-lg px-6 py-[10px] text-[14px] font-semibold hover:bg-gaia-dark transition-colors whitespace-nowrap">
            Subscribe free
          </button>
        </form>
        <p class="text-[12px] text-gaia-border mt-3">No spam. Unsubscribe any time.</p>
      </div>
    </section>

  </div>

</Layout>
