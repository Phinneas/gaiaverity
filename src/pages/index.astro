---
import Container from "@/components/container.astro";
import Postlist from "@/components/postlist.astro";
import Layout from "@/layouts/Layout.astro";
import { getLocalPosts } from "@/utils/content";
import { getD1Posts } from "@/utils/content-d1";

export const prerender = false;

let posts = [];

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    const d1Posts = await getD1Posts(db);
    if (d1Posts.length > 0) {
      posts = d1Posts;
    }
  }
} catch (e) {
  console.error("D1 fetch error:", e);
}

if (posts.length === 0) {
  posts = await getLocalPosts();
}

const latestPosts = posts;
---

<Layout title="">
  <Container>
    <main>
      <div class="grid gap-10 lg:gap-10 md:grid-cols-2">
        {
          latestPosts
            .slice(0, 2)
            .map((post) => (
              <Postlist post={post} aspect="landscape" preloadImage={true} />
            ))
        }
      </div>
      <div class="grid gap-10 mt-10 lg:gap-10 md:grid-cols-2 xl:grid-cols-3">
        {
          latestPosts
            .slice(2)
            .map((post) => <Postlist post={post} aspect="square" />)
        }
      </div>
    </main>
  </Container>
</Layout>
