---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Contact — GaiaVerity" desc="Get in touch with GaiaVerity.">

  <section style="background:#f7f5f0; padding:72px 24px 96px;">
    <div style="max-width:680px; margin:0 auto;">

      <p class="font-sans" style="font-size:11px; font-weight:600; letter-spacing:0.18em; text-transform:uppercase; color:#c98633; margin-bottom:20px;">Contact</p>
      <h1 class="font-sans" style="font-size:clamp(32px,5vw,48px); font-weight:700; line-height:1.1; letter-spacing:-0.02em; color:#23312b; margin-bottom:24px;">Get in touch</h1>

      <p class="font-serif" style="font-size:17px; line-height:1.8; color:#23312b; margin-bottom:36px;">
        For gardening questions, partnership inquiries, or feedback, reach out.
      </p>

      <a
        href="mailto:buzzUW2@gmail.com"
        class="font-sans"
        style="display:inline-flex; align-items:center; gap:10px; background:#23312b; color:#f7f5f0; border-radius:999px; padding:16px 32px; font-size:15px; font-weight:600; text-decoration:none;">
        buzzUW2@gmail.com
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M3 8l9 6 9-6M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <p class="font-serif" style="font-size:14px; line-height:1.7; color:#5c7962; margin-top:24px;">
        We typically reply within a few days.
      </p>

    </div>
  </section>

</Layout>
