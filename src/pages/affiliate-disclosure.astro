---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Affiliate Disclosure — GaiaVerity" desc="How affiliate links work on GaiaVerity.">

  <section style="background:#f7f5f0; padding:72px 24px 96px;">
    <div style="max-width:680px; margin:0 auto;">

      <p class="font-sans" style="font-size:11px; font-weight:600; letter-spacing:0.18em; text-transform:uppercase; color:#c98633; margin-bottom:20px;">Legal</p>
      <h1 class="font-sans" style="font-size:clamp(32px,5vw,48px); font-weight:700; line-height:1.1; letter-spacing:-0.02em; color:#23312b; margin-bottom:24px;">Affiliate Disclosure</h1>

      <div class="font-serif" style="font-size:16.5px; line-height:1.85; color:#23312b;">

        <p>Some links on GaiaVerity are affiliate links. If you buy through one, I may earn a small commission at no extra cost to you. I only link to products I think fit the topic. Affiliate income never changes what I recommend or how I describe a product's tradeoffs. Questions? Use the <a href="/contact/" style="color:#3B6D11;">contact page</a>.</p>

      </div>
    </div>
  </section>

</Layout>
