---
export const prerender = true;
import { Image, Picture } from "astro:assets";
import Authorcard from "@/components/authorcard.astro";
import Container from "@/components/container.astro";
import Label from "@/components/ui/label.astro";
import { authors } from "@/data/authors";
import { categories } from "@/data/category";
import Layout from "@/layouts/Layout.astro";
import { getFormattedDate } from "@/utils/all";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const mdxPosts = await getCollection("blog", ({ data }) => data.draft !== true);

  const paths = [];

  for (const post of mdxPosts) {
    const { Content } = await render(post);
    const slug = post.slug || post.id;
    const authorName = post.data.author || "Admin";
    const author = authors.find(
      (item) => item.slug === authorName || item.name.toLowerCase() === authorName.toLowerCase()
    ) || {
      name: authorName,
      slug: authorName.toLowerCase().replace(/\s+/g, "-"),
      image: "",
    };
    const categorySlug = (post.data.category || "general").toLowerCase();
    const category = categories.find((item) => item.slug === categorySlug) || {
      title: post.data.category || "General",
      slug: categorySlug,
      color: "blue",
    };

    paths.push({
      params: { slug },
      props: {
        title: post.data.title,
        excerpt: post.data.excerpt,
        postImage: post.data.image || "",
        publishDate: post.data.publishDate,
        modifiedDate: post.data.modifiedDate || undefined,
        author,
        category,
        tags: post.data.tags || [],
        faq: post.data.faq || [],
        hideFaqSection: post.data.hideFaqSection || false,
        Content,
        noindex: post.data.noindex || false,
      },
    });
  }

  return paths;
}

interface Props {
  title: string;
  excerpt: string;
  postImage: any;
  publishDate: any;
  modifiedDate?: Date;
  author: any;
  category: any;
  tags: string[];
  faq: { question: string; answer: string }[];
  hideFaqSection: boolean;
  Content: any;
  noindex: boolean;
}

const {
  title,
  excerpt,
  postImage,
  publishDate,
  modifiedDate,
  author,
  category,
  tags,
  faq,
  hideFaqSection,
  Content,
  noindex,
} = Astro.props;

const isExternalImage = typeof postImage === "string" && postImage.startsWith("http");

const displayDate = modifiedDate || publishDate;
const publishISO = publishDate ? new Date(publishDate).toISOString() : undefined;
const modifiedISO = modifiedDate ? new Date(modifiedDate).toISOString() : publishISO;

const schemas: Record<string, any>[] = [{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: excerpt,
  datePublished: publishISO,
  dateModified: modifiedISO,
  author: {
    "@type": "Person",
    name: author.name,
    url: `https://www.gaiaverity.com/about/${author.slug}/`,
  },
  publisher: {
    "@type": "Organization",
    name: "GaiaVerity",
    url: "https://www.gaiaverity.com",
  },
  ...(postImage ? { image: typeof postImage === "string" ? postImage : undefined } : {}),
}];

if (faq && faq.length > 0) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item: { question: string; answer: string }) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  });
}
---

<Layout
  title={title}
  desc={excerpt}
  ogimage={postImage}
  noindex={noindex}>
  <script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} slot="head" />
  <Container>
    <div class="max-w-screen-md mx-auto">
      <div class="text-center">
        <Label theme={category.color}>{category.title}</Label>
      </div>

      <h1
        class="mt-2 mb-3 text-3xl font-semibold tracking-tight text-center lg:leading-snug text-gaia-ink lg:text-4xl">
        {title}
      </h1>

      <div class="flex justify-center mt-3 space-x-3 text-gaia-ink/60">
        <div class="flex items-center gap-3">
          <div class="relative flex-shrink-0">
            {
              author.image && (
                <Image
                  src={author.image}
                  alt="Author Photo"
                  width={80}
                  height={80}
                  loading="eager"
                  class="rounded-full object-cover w-10 h-10"
                />
              )
            }
          </div>

          <div>
            <p class="text-gaia-ink">
              <a href={`/about/${author.slug}/`} class="hover:text-gaia-gold transition-colors">{author.name}</a>
            </p>
            <div class="flex items-center space-x-2 text-sm">
              <time
                class="text-gaia-ink/60"
                datetime={displayDate}>
                {modifiedDate ? `Updated ${getFormattedDate(modifiedDate)}` : getFormattedDate(publishDate)}
              </time>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>

  {postImage && (
    <div
      class="relative z-0 max-w-screen-lg mx-auto overflow-hidden lg:rounded-lg aspect-video">
      {isExternalImage ? (
        <img
          src={postImage}
          alt={title}
          loading="eager"
          class="w-full object-cover"
        />
      ) : (
        <Picture
          src={postImage}
          widths={[200, 400, 800, 1200]}
          sizes="(max-width: 640px) 90vw, 480px"
          alt={title}
          loading="eager"
          class="w-full object-cover"
        />
      )}
    </div>
  )}

  <Container>
    <article class="max-w-screen-md mx-auto">
      <div
        class="mx-auto my-3 prose prose-base prose-headings:text-gaia-ink prose-p:text-gaia-ink prose-li:text-gaia-ink prose-strong:text-gaia-ink prose-a:text-gaia-mid hover:prose-a:text-gaia-dark prose-blockquote:text-gaia-ink">

        <Content />

        {faq && faq.length > 0 && !hideFaqSection && (
          <section class="mt-10 pt-8 border-t border-gaia-border/30">
            <h2 class="font-sans text-2xl font-semibold text-gaia-ink mb-6">Frequently Asked Questions</h2>
            <div class="space-y-6">
              {faq.map((item: { question: string; answer: string }) => (
                <div>
                  <h3 class="font-sans text-lg font-semibold text-gaia-ink mb-2">{item.question}</h3>
                  <p class="text-gaia-ink/80 leading-relaxed">{item.answer}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {tags && tags.length > 0 && (
          <div class="flex flex-wrap items-center w-full gap-3 md:w-auto">
            {
              tags.map((tag: string) => (
                <span class="text-sm text-gray-500">#{tag}</span>
              ))
            }
          </div>
        )}
      </div>

      <div class="flex justify-center mt-7 mb-7">
        <a
          href="/"
          class="px-5 py-3 text-sm text-gaia-mid transition rounded-md bg-gaia-pale hover:bg-gaia-pale/70">
          &larr; View all posts
        </a>
      </div>
      {author && <Authorcard author={author} />}
    </article>
  </Container>
</Layout>