---
import { Image, Picture } from "astro:assets";
import Authorcard from "@/components/authorcard.astro";
import Container from "@/components/container.astro";
import Label from "@/components/ui/label.astro";
import { authors } from "@/data/authors";
import { categories } from "@/data/category";
import Layout from "@/layouts/Layout.astro";
import { getFormattedDate } from "@/utils/all";
import { getCollection } from "astro:content";
import { fetchCmsPosts } from "@/lib/sonicjs";
import type { CmsPost } from "@/lib/sonicjs";

export async function getStaticPaths() {
  const [mdxPosts, cmsPosts] = await Promise.all([
    getCollection("blog", ({ data }) => data.draft !== true),
    fetchCmsPosts(),
  ]);

  const mdxSlugs = new Set(mdxPosts.map((p: any) => p.slug));

  const mdxRoutes = mdxPosts.map((post: any) => ({
    params: { slug: post.slug },
    props: { post, cmsPost: null },
  }));

  const cmsRoutes = cmsPosts
    .filter((p: CmsPost) => !mdxSlugs.has(p.slug))
    .map((cmsPost: CmsPost) => ({
      params: { slug: cmsPost.slug },
      props: { post: null, cmsPost },
    }));

  return [...mdxRoutes, ...cmsRoutes];
}

const { post, cmsPost } = Astro.props;

// Render MDX content if it's an MDX post
let Content: any = null;
if (post) {
  const rendered = await post.render();
  Content = rendered.Content;
}

// Normalise fields from whichever source we have
const title       = post ? post.data.title       : cmsPost.title;
const excerpt     = post ? post.data.excerpt      : cmsPost.excerpt;
const postImage   = post ? (post.data.image || '') : (cmsPost.featureimage || '');
const publishDate = post ? post.data.publishDate  : cmsPost.publishedAt;
const authorSlug  = post ? post.data.author       : null;
const htmlContent = cmsPost ? cmsPost.htmlContent : null;

const isExternalImage = typeof postImage === 'string' && postImage.startsWith('http');

const author = authors.find((item) => item.slug === authorSlug) || {
  name: post?.data?.author || cmsPost?.author || "Admin",
  slug: "admin",
  image: ""
};

const categorySlug = post?.data?.category || "general";
const category = categories.find(
  (item) => item.slug === categorySlug.toLowerCase()
) || {
  title: post?.data?.category || "General",
  slug: categorySlug.toLowerCase(),
  color: "blue"
};
---

<Layout
  title={title}
  desc={excerpt}
  ogimage={postImage}>
  <Container>
    <div class="max-w-screen-md mx-auto">
      <div class="text-center">
        <Label theme={category.color}>{category.title}</Label>
      </div>

      <h1
        class="mt-2 mb-3 text-3xl font-semibold tracking-tight text-center lg:leading-snug text-gaia-ink lg:text-4xl">
        {title}
      </h1>

      <div class="flex justify-center mt-3 space-x-3 text-gaia-ink/60">
        <div class="flex items-center gap-3">
          <div class="relative flex-shrink-0">
            {
              author.image && (
                <Image
                  src={author.image}
                  alt="Author Photo"
                  width={80}
                  height={80}
                  loading="eager"
                  class="rounded-full object-cover w-10 h-10"
                />
              )
            }
          </div>

          <div>
            <p class="text-gaia-ink">
              {author.name}
            </p>
            <div class="flex items-center space-x-2 text-sm">
              <time
                class="text-gaia-ink/60"
                datetime={publishDate}>
                {getFormattedDate(publishDate)}
              </time>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>

  {postImage && (
    <div
      class="relative z-0 max-w-screen-lg mx-auto overflow-hidden lg:rounded-lg aspect-video">
      {isExternalImage ? (
        <img
          src={postImage}
          alt="Thumbnail"
          loading="eager"
          class="w-full object-cover"
        />
      ) : (
        <Picture
          src={postImage}
          widths={[200, 400, 800, 1200]}
          sizes="(max-width: 640px) 90vw, 480px"
          alt="Thumbnail"
          loading="eager"
          class="w-full object-cover"
        />
      )}
    </div>
  )}

  <Container>
    <article class="max-w-screen-md mx-auto">
      <div
        class="mx-auto my-3 prose prose-base prose-headings:text-gaia-ink prose-p:text-gaia-ink prose-li:text-gaia-ink prose-strong:text-gaia-ink prose-a:text-gaia-mid hover:prose-a:text-gaia-dark prose-blockquote:text-gaia-ink">

        {Content ? (
          <Content />
        ) : (
          <div set:html={htmlContent} />
        )}

        {post?.data?.tags && (
          <div class="flex flex-wrap items-center w-full gap-3 md:w-auto">
            {
              (post.data.tags || []).map((tag: string) => (
                <span class="text-sm text-gray-500">#{tag}</span>
              ))
            }
          </div>
        )}
      </div>

      <div class="flex justify-center mt-7 mb-7">
        <a
          href="/"
          class="px-5 py-3 text-sm text-gaia-mid transition rounded-md bg-gaia-pale hover:bg-gaia-pale/70">
          &larr; View all posts
        </a>
      </div>
      {author && <Authorcard author={author} />}
    </article>
  </Container>
</Layout>
