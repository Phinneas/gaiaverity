---
import { Image, Picture } from "astro:assets";
import Authorcard from "@/components/authorcard.astro";
import Container from "@/components/container.astro";
import Label from "@/components/ui/label.astro";
import { authors } from "@/data/authors";
import { categories } from "@/data/category";
import Layout from "@/layouts/Layout.astro";
import { getFormattedDate } from "@/utils/all";
import { getEntry } from "astro:content";
import { getD1PostBySlug } from "@/utils/content-d1";

export const prerender = false;

const { slug } = Astro.params;

// 1. Try local collection first
let post = await getEntry("blog", slug);

// 2. If not found, try D1
if (!post) {
  const db = Astro.locals.runtime?.env?.DB;
  post = await getD1PostBySlug(db, slug);
}

if (!post) {
  return Astro.redirect("/404");
}

// For D1 posts, we don't have a .render() method like Astro content.
// We'll just use the content directly from data.
const Content = post.data.content;

const author = authors.find((item) => item.slug === post.data.author) || {
  name: post.data.author || "Admin",
  slug: post.data.author || "admin",
  image: ""
};

// Extremely defensive category lookup
const categoryName = post.data.category || "General";
const categorySlug = (typeof categoryName === 'string' ? categoryName : "general").toLowerCase();

const foundCategory = categories.find((item) => item.slug === categorySlug);

const category = foundCategory || {
  title: typeof categoryName === 'string' ? categoryName : "General",
  slug: categorySlug,
  color: "blue"
};

console.log(`Building post: ${slug}, Category: ${categoryName}, Resolved:`, category);

---

<Layout
  title={post.data.title}
  desc={post.data.excerpt}
  ogimage={post.data.image}>
  <Container>
    <div class="max-w-screen-md mx-auto">
      <div class="text-center">
        <Label theme={category.color}>{category.title}</Label>
      </div>

      <h1
        class="mt-2 mb-3 text-3xl font-semibold tracking-tight text-center lg:leading-snug text-brand-primary lg:text-4xl dark:text-white">
        {post.data.title}
      </h1>

      <div class="flex justify-center mt-3 space-x-3 text-gray-500">
        <div class="flex items-center gap-3">
          <div class="relative flex-shrink-0">
            {
              author.image && (
                <Image
                  src={author.image}
                  alt="Author Photo"
                  width={80}
                  height={80}
                  loading="eager"
                  class="rounded-full object-cover w-10 h-10"
                />
              )
            }
          </div>

          <div>
            <p class="text-gray-800 dark:text-gray-400">
              {author.name}
            </p>
            <div class="flex items-center space-x-2 text-sm">
              <time
                class="text-gray-500 dark:text-gray-400"
                datetime={post.data.publishDate}>
                {getFormattedDate(post.data.publishDate)}
              </time>
              <!-- <span>
                · {Math.round(remarkPluginFrontmatter?.estReadingTime) || "5"} min
                read
              </span> -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>

  <div
    class="relative z-0 max-w-screen-lg mx-auto overflow-hidden lg:rounded-lg aspect-video">
    {
      post.data.image && (
        <Picture
          src={post.data.image}
          widths={[200, 400, 800, 1200]}
          sizes="(max-width: 640px) 90vw, 480px"
          alt="Thumbnail"
          inferSize={typeof post.data.image === "string" && post.data.image.includes("gaiaverity.com") ? false : true}
          width={typeof post.data.image === "string" && post.data.image.includes("gaiaverity.com") ? 1200 : undefined}
          height={typeof post.data.image === "string" && post.data.image.includes("gaiaverity.com") ? 675 : undefined}
          loading="eager"
          class="w-full object-cover"
        />
      )
    }
  </div>

  <Container>
    <article class="max-w-screen-md mx-auto">
      <div
        class="mx-auto my-3 prose prose-base dark:prose-invert prose-a:text-blue-600">
        {typeof Content === 'string' ? <div set:html={Content} /> : <Content />}

        <div class="flex flex-wrap items-center w-full gap-3 md:w-auto">
          {
            post.data.tags.map((tag) => (
              <span class="text-sm text-gray-500">#{tag}</span>
            ))
          }
        </div>
      </div>

      <div class="flex justify-center mt-7 mb-7">
        <a
          href="/"
          class="px-5 py-3 text-sm text-blue-600 transition rounded-md dark:bg-gray-700 dark:text-white bg-blue-50 hover:bg-blue-100">
          ← View all posts
        </a>
      </div>
      {author && <Authorcard author={author} />}
    </article>
  </Container>
</Layout>
