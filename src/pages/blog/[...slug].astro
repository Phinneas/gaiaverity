---
import { Image, Picture } from "astro:assets";
import Authorcard from "@/components/authorcard.astro";
import Container from "@/components/container.astro";
import Label from "@/components/ui/label.astro";
import { authors } from "@/data/authors";
import { categories } from "@/data/category";
import Layout from "@/layouts/Layout.astro";
import { getFormattedDate } from "@/utils/all";
import { getEntry } from "astro:content";
import { getD1PostBySlug } from "@/utils/content-d1";

export const prerender = false;

const { slug } = Astro.params;

let post = null;
let isD1Post = false;

try {
  post = await getEntry("blog", slug);
} catch (e) {
  // Local collection lookup failed
}

if (!post) {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    try {
      post = await getD1PostBySlug(db, slug);
      isD1Post = true;
    } catch (e) {
      console.error("D1 lookup error:", e);
    }
  }
}

if (!post) {
  return Astro.redirect("/404");
}

const postTitle = post.data?.title || 'Untitled';
const postExcerpt = post.data?.excerpt || '';
const postImage = post.data?.image || '';
const isExternalImage = typeof postImage === 'string' && (postImage.includes('unsplash.com') || postImage.includes('gaiaverity.com'));
const postDate = post.data?.publishDate || new Date().toISOString();

const authorName = post.data?.author || "Admin";
const author = authors.find((item) => item.slug === authorName) || {
  name: authorName,
  slug: authorName.toLowerCase().replace(/\s+/g, "-"),
  image: ""
};

const categoryName = post.data?.category || "General";
const categorySlug = (typeof categoryName === 'string' ? categoryName : "general").toLowerCase();
const foundCategory = categories.find((item) => item.slug === categorySlug);
const category = foundCategory || {
  title: typeof categoryName === 'string' ? categoryName : "General",
  slug: categorySlug,
  color: "blue"
};

let htmlContent = '';
if (isD1Post) {
  htmlContent = post.data?.content || '';
} else {
  // For local collection posts, use the render method
}
---

<Layout
  title={postTitle}
  desc={postExcerpt}
  ogimage={postImage}>
  <Container>
    <div class="max-w-screen-md mx-auto">
      <div class="text-center">
        <Label theme={category.color}>{category.title}</Label>
      </div>

      <h1
        class="mt-2 mb-3 text-3xl font-semibold tracking-tight text-center lg:leading-snug text-brand-primary lg:text-4xl dark:text-white">
        {postTitle}
      </h1>

      <div class="flex justify-center mt-3 space-x-3 text-gray-500">
        <div class="flex items-center gap-3">
          <div class="relative flex-shrink-0">
            {
              author.image && (
                <Image
                  src={author.image}
                  alt="Author Photo"
                  width={80}
                  height={80}
                  loading="eager"
                  class="rounded-full object-cover w-10 h-10"
                />
              )
            }
          </div>

          <div>
            <p class="text-gray-800 dark:text-gray-400">
              {author.name}
            </p>
            <div class="flex items-center space-x-2 text-sm">
              <time
                class="text-gray-500 dark:text-gray-400"
                datetime={postDate}>
                {getFormattedDate(postDate)}
              </time>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>

  {postImage && (
    <div
      class="relative z-0 max-w-screen-lg mx-auto overflow-hidden lg:rounded-lg aspect-video">
      {isExternalImage ? (
        <img
          src={postImage}
          alt="Thumbnail"
          loading="eager"
          class="w-full object-cover"
        />
      ) : (
        <Picture
          src={postImage}
          widths={[200, 400, 800, 1200]}
          sizes="(max-width: 640px) 90vw, 480px"
          alt="Thumbnail"
          loading="eager"
          class="w-full object-cover"
        />
      )}
    </div>
  )}

  <Container>
    <article class="max-w-screen-md mx-auto">
      <div
        class="mx-auto my-3 prose prose-base dark:prose-invert prose-a:text-blue-600">
        {isD1Post ? (
          <div set:html={htmlContent} />
        ) : (
          <post.Content />
        )}

        <div class="flex flex-wrap items-center w-full gap-3 md:w-auto">
          {
            (post.data?.tags || []).map((tag) => (
              <span class="text-sm text-gray-500">#{tag}</span>
            ))
          }
        </div>
      </div>

      <div class="flex justify-center mt-7 mb-7">
        <a
          href="/"
          class="px-5 py-3 text-sm text-blue-600 transition rounded-md dark:bg-gray-700 dark:text-white bg-blue-50 hover:bg-blue-100">
          &larr; View all posts
        </a>
      </div>
      {author && <Authorcard author={author} />}
    </article>
  </Container>
</Layout>
