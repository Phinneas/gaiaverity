---
export const prerender = true;
import { Image, Picture } from "astro:assets";
import Authorcard from "@/components/authorcard.astro";
import Container from "@/components/container.astro";
import Label from "@/components/ui/label.astro";
import { authors } from "@/data/authors";
import { categories } from "@/data/category";
import Layout from "@/layouts/Layout.astro";
import { getFormattedDate } from "@/utils/all";
import { getCollection, render } from "astro:content";
import { fetchCmsPosts } from "@/lib/sonicjs";

export async function getStaticPaths() {
  const [mdxPosts, cmsPosts] = await Promise.all([
    getCollection("blog", ({ data }) => data.draft !== true),
    fetchCmsPosts(),
  ]);

  const mdxSlugs = new Set(mdxPosts.map((p: any) => p.slug || p.id));
  const paths = [];

  for (const post of mdxPosts) {
    const { Content } = await render(post);
    const slug = post.slug || post.id;
    const authorSlug = post.data.author;
    const author = authors.find((item) => item.slug === authorSlug) || {
      name: post.data.author || "Admin",
      slug: "admin",
      image: "",
    };
    const categorySlug = (post.data.category || "general").toLowerCase();
    const category = categories.find((item) => item.slug === categorySlug) || {
      title: post.data.category || "General",
      slug: categorySlug,
      color: "blue",
    };

    paths.push({
      params: { slug },
      props: {
        title: post.data.title,
        excerpt: post.data.excerpt,
        postImage: post.data.image || "",
        publishDate: post.data.publishDate,
        author,
        category,
        tags: post.data.tags || [],
        Content,
        htmlContent: null as string | null,
      },
    });
  }

  for (const cmsPost of cmsPosts) {
    if (mdxSlugs.has(cmsPost.slug)) continue;
    paths.push({
      params: { slug: cmsPost.slug },
      props: {
        title: cmsPost.title,
        excerpt: cmsPost.excerpt,
        postImage: cmsPost.featureimage || "",
        publishDate: cmsPost.publishedAt,
        author: { name: cmsPost.author || "Admin", slug: "admin", image: "" },
        category: { title: "General", slug: "general", color: "blue" },
        tags: [],
        Content: null,
        htmlContent: cmsPost.htmlContent,
      },
    });
  }

  return paths;
}

interface Props {
  title: string;
  excerpt: string;
  postImage: any;
  publishDate: any;
  author: any;
  category: any;
  tags: string[];
  Content: any;
  htmlContent: string | null;
}

const {
  title,
  excerpt,
  postImage,
  publishDate,
  author,
  category,
  tags,
  Content,
  htmlContent,
} = Astro.props;

const isExternalImage = typeof postImage === "string" && postImage.startsWith("http");

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: excerpt,
  datePublished: publishDate ? new Date(publishDate).toISOString() : undefined,
  author: { "@type": "Person", name: author.name },
  publisher: { "@type": "Organization", name: "GaiaVerity" },
  ...(postImage ? { image: typeof postImage === "string" ? postImage : undefined } : {}),
};
---

<Layout
  title={title}
  desc={excerpt}
  ogimage={postImage}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
  <Container>
    <div class="max-w-screen-md mx-auto">
      <div class="text-center">
        <Label theme={category.color}>{category.title}</Label>
      </div>

      <h1
        class="mt-2 mb-3 text-3xl font-semibold tracking-tight text-center lg:leading-snug text-gaia-ink lg:text-4xl">
        {title}
      </h1>

      <div class="flex justify-center mt-3 space-x-3 text-gaia-ink/60">
        <div class="flex items-center gap-3">
          <div class="relative flex-shrink-0">
            {
              author.image && (
                <Image
                  src={author.image}
                  alt="Author Photo"
                  width={80}
                  height={80}
                  loading="eager"
                  class="rounded-full object-cover w-10 h-10"
                />
              )
            }
          </div>

          <div>
            <p class="text-gaia-ink">
              {author.name}
            </p>
            <div class="flex items-center space-x-2 text-sm">
              <time
                class="text-gaia-ink/60"
                datetime={publishDate}>
                {getFormattedDate(publishDate)}
              </time>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>

  {postImage && (
    <div
      class="relative z-0 max-w-screen-lg mx-auto overflow-hidden lg:rounded-lg aspect-video">
      {isExternalImage ? (
        <img
          src={postImage}
          alt="Thumbnail"
          loading="eager"
          class="w-full object-cover"
        />
      ) : (
        <Picture
          src={postImage}
          widths={[200, 400, 800, 1200]}
          sizes="(max-width: 640px) 90vw, 480px"
          alt="Thumbnail"
          loading="eager"
          class="w-full object-cover"
        />
      )}
    </div>
  )}

  <Container>
    <article class="max-w-screen-md mx-auto">
      <div
        class="mx-auto my-3 prose prose-base prose-headings:text-gaia-ink prose-p:text-gaia-ink prose-li:text-gaia-ink prose-strong:text-gaia-ink prose-a:text-gaia-mid hover:prose-a:text-gaia-dark prose-blockquote:text-gaia-ink">

        {Content ? (
          <Content />
        ) : (
          <div set:html={htmlContent} />
        )}

        {tags && tags.length > 0 && (
          <div class="flex flex-wrap items-center w-full gap-3 md:w-auto">
            {
              tags.map((tag: string) => (
                <span class="text-sm text-gray-500">#{tag}</span>
              ))
            }
          </div>
        )}
      </div>

      <div class="flex justify-center mt-7 mb-7">
        <a
          href="/"
          class="px-5 py-3 text-sm text-gaia-mid transition rounded-md bg-gaia-pale hover:bg-gaia-pale/70">
          &larr; View all posts
        </a>
      </div>
      {author && <Authorcard author={author} />}
    </article>
  </Container>
</Layout>
