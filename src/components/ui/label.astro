---
import cx from "classnames";

interface Props {
  theme: "green" | "blue" | "orange" | "purple" | "pink";
}
const color = {
  green:  "text-gaia-mid",
  blue:   "text-gaia-border",
  orange: "text-[#c47a3a]",
  purple: "text-gaia-sage",
  pink:   "text-[#a17060]",
};

const { theme } = Astro.props;
---

<span
  class={cx(
    "inline-block mt-5 text-xs font-medium tracking-wider uppercase",
    color[theme] || color["green"]
  )}>
  <slot />
</span>
