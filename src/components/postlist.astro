---
import cx from "classnames";

import { Image, Picture } from "astro:assets";
import Label from "@/components/ui/label.astro";
import type { Author } from "@/data/authors";
import { authors } from "@/data/authors";
import type { Category } from "@/data/category";
import { categories } from "@/data/category";
import { getFormattedDate } from "@/utils/all";
import { Icon } from "astro-icon/components";

const { post, aspect, preloadImage } = Astro.props;

const authorName = post.data?.author || "Admin";
const author = authors.find((item) => item.slug === authorName) || {
  name: authorName,
  slug: authorName.toLowerCase().replace(/\s+/g, "-"),
  image: ""
};

const categoryName = post.data?.category || "General";
const categorySlug = (typeof categoryName === 'string' ? categoryName : "general").toLowerCase();
const foundCategory = categories.find((item) => item.slug === categorySlug);
const category = foundCategory || {
  title: typeof categoryName === 'string' ? categoryName : "General",
  slug: categorySlug,
  color: "blue"
};

const postSlug = post.slug || '';
const postImage = post.data?.image || '';
const isExternalImage = typeof postImage === 'string' && (postImage.includes('unsplash.com') || postImage.includes('gaiaverity.com'));
const postTitle = post.data?.title || 'Untitled';
const postExcerpt = post.data?.excerpt || '';
const postDate = post.data?.publishDate || new Date().toISOString();
---

<div class="cursor-pointer group">
  <div
    class={cx(
      "relative overflow-hidden transition-all bg-gaia-pale rounded-md hover:scale-[1.02]",
      aspect === "landscape" ? "aspect-video" : "aspect-square"
    )}>
    <a href={"/blog/" + postSlug}>
      {
        postImage ? (
          isExternalImage ? (
            <img
              src={postImage}
              alt="Thumbnail"
              loading={preloadImage ? "eager" : "lazy"}
              class="w-full h-full rounded-md object-cover"
            />
          ) : (
            <Picture
              src={postImage}
              widths={[200, 400, 800]}
              sizes="(max-width: 640px) 90vw, 480px"
              alt="Thumbnail"
              loading={preloadImage ? "eager" : "lazy"}
              class="w-full h-full rounded-md object-cover"
            />
          )
        ) : (
          <span class="absolute w-16 h-16 text-gray-200 -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2">
            <Icon
              class="w-4 h-4 text-black"
              name="heroicons:photo"
            />
          </span>
        )
      }
    </a>
  </div>

  <a href={"/archive?category=" + category.slug}>
    <Label theme={category.color}>{category.title}</Label>
  </a>
  <h2
    class="mt-2 text-base font-semibold leading-snug text-gaia-ink">
    <a href={"/blog/" + postSlug}>
      <span
        class="bg-gradient-to-r from-gaia-pale to-gaia-pale bg-[length:0px_10px] bg-left-bottom bg-no-repeat transition-[background-size] duration-500 hover:bg-[length:100%_3px] group-hover:bg-[length:100%_10px]">
        {postTitle}
      </span>
    </a>
  </h2>

  {
    postExcerpt && (
      <p class="mt-2 text-sm text-gray-500 leading-relaxed line-clamp-2">
        {postExcerpt}
      </p>
    )
  }

  <div
    class="flex items-center mt-3 space-x-3 text-gray-400">
    <div class="flex items-center gap-3">
      <div class="relative flex-shrink-0 w-5 h-5">
        {
          author.image && (
            <Image
              src={author.image}
              alt="Author Photo"
              width={40}
              height={40}
              loading="lazy"
              class="rounded-full"
            />
          )
        }
      </div>
      <span class="text-sm">{author.name}</span>
    </div>
    <span class="text-xs text-gray-300"> &bull;</span>
    <time class="text-sm" datetime={postDate}>
      {getFormattedDate(postDate)}
    </time>
  </div>
</div>
