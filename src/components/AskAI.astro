---
interface Props {
  productName: string;
  url: string;
  useCase: string;
  alternatives: string[];
}

const { productName, url, useCase, alternatives } = Astro.props;

const prompt = `How would ${productName} at ${url} help me ${useCase}, and what makes it different from ${alternatives.join(" or ")}? Be honest about who it's best for and where it falls short.`;
const encoded = encodeURIComponent(prompt);

const platforms = [
  { key: "chatgpt", label: "ChatGPT", href: `https://chatgpt.com/?q=${encoded}` },
  { key: "claude", label: "Claude", href: `https://claude.ai/new?q=${encoded}` },
  { key: "perplexity", label: "Perplexity", href: `https://www.perplexity.ai/?q=${encoded}` },
];
---

<section class="text-center py-8">
  <h3 class="font-sans font-semibold text-[1.25rem] tracking-[-0.01em] text-gaia-ink mb-2">Not sure yet?</h3>
  <p class="font-serif text-[0.95rem] text-gaia-forest mb-6 leading-[1.6]">Ask an AI for a second opinion on whether {productName} is right for you.</p>
  <div class="flex flex-wrap gap-3 justify-center max-w-[600px] mx-auto">
    {platforms.map((p) => (
      <a
        href={p.href}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          "inline-flex items-center gap-2 rounded-full px-5 py-2.5 font-sans text-[0.875rem] font-semibold border transition-all hover:-translate-y-0.5 hover:shadow-sm",
          p.key === "chatgpt" && "bg-white border-gaia-border/50 text-gaia-forest hover:border-[#10a37f] hover:text-[#10a37f]",
          p.key === "claude" && "bg-white border-gaia-border/50 text-gaia-forest hover:border-[#d97757] hover:text-[#d97757]",
          p.key === "perplexity" && "bg-white border-gaia-border/50 text-gaia-forest hover:border-[#20808d] hover:text-[#20808d]",
        ]}
        aria-label={`Ask ${p.label} about ${productName}`}
      >
        <span>Ask {p.label}</span>
      </a>
    ))}
  </div>
</section>
