---
import Container from "./container.astro";
---

<Container class="mt-16 border-t border-black/8">
  <footer class="py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <span class="font-serif text-sm font-medium text-gaia-ink">GaiaVerity</span>
      <span class="text-gray-300">·</span>
      <span class="text-xs text-gray-400">Grow something real.</span>
    </div>
    <nav class="flex items-center gap-6">
      <a href="/blog" class="text-xs text-gray-400 hover:text-gaia-mid transition-colors">Articles</a>
      <a href="/about" class="text-xs text-gray-400 hover:text-gaia-mid transition-colors">About</a>
    </nav>
    <p class="text-xs text-gray-400">
      © {new Date().getFullYear()} GaiaVerity
    </p>
  </footer>
</Container>
