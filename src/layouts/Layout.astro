---
import "@fontsource-variable/cabin";
import "@fontsource-variable/fraunces";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar.astro";
import { checkImageUrl } from "@/utils/all";
import { SEO } from "astro-seo";

export interface Props {
  title?: string;
  desc?: string;
  ogimage?: string;
}

// Strip query params (e.g. ?ref=) from canonical — use pathname only
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const { title, desc, ogimage = "/opengraph.jpg" } = Astro.props;

const resolvedOGImage = checkImageUrl(ogimage, Astro.site);

const makeTitle = title
  ? title + " | " + "GaiaVerity"
  : "GaiaVerity — Garden & Sustainable Living Blog";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="MklFYKiskv0qOfIlSue5K5wOYu0WuS5uWUjnk7J4UXI" />
    <SEO
      title={makeTitle}
      description={desc ||
        "Real, practical gardening advice for home gardeners — from lawn mushrooms to drought-tolerant borders."}
      canonical={canonicalURL}
      twitter={{
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `GaiaVerity - Garden & Sustainable Living Blog`,
          image: resolvedOGImage,
        },
        image: {
          alt: "GaiaVerity",
        },
      }}
    />
    <!-- LinkStorm link placement code -->
    <script
      defer
      src="https://linkstorm.io/linkstorm_site_linker.js?projectId=3642&websiteId=3643"
    ></script>

    <!-- Plausible Analytics -->
    <script
      defer
      data-domain="gaiaverity.com"
      src="https://plausible-production.up.railway.app/js/script.js"></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
    </script>

    <!-- Matomo -->
    <script is:inline>
      var _paq = (window._paq = window._paq || []);
      /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
      _paq.push(["trackPageView"]);
      _paq.push(["enableLinkTracking"]);
      (function () {
        var u = "//complex-honeybee.pikapod.net/";
        _paq.push(["setTrackerUrl", u + "matomo.php"]);
        _paq.push(["setSiteId", "1"]);
        var d = document,
          g = d.createElement("script"),
          s = d.getElementsByTagName("script")[0];
        g.async = true;
        g.src = u + "matomo.js";
        s.parentNode.insertBefore(g, s);
      })();
    </script>
    <!-- End Matomo Code -->
    <slot name="head" />
  </head>
  <body class="bg-white">
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      body { background-color: #f7f5f0; color: #23312b; font-family: "Fraunces Variable", "Fraunces", Georgia, serif; }
      h1, h2, h3, h4, h5, h6 { color: #23312b; font-family: "Cabin Variable", "Cabin", sans-serif; }
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
